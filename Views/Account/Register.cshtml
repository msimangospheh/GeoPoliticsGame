@model GeoPolitics_Game.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign up";
}

<section class="auth-wrap">
    <div class="panel auth-card">
        <p class="eyebrow">Enlist</p>
        <h1 class="mb-1">Sign up free</h1>
        <p class="muted mb-4">Choose your commander name and start conquering.</p>

        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly"></div>

            <div class="mb-3">
                <label asp-for="DisplayName" class="form-label"></label>
                <input asp-for="DisplayName" class="form-control" placeholder="e.g. Sphe" autocomplete="nickname" />
                <span asp-validation-for="DisplayName" class="field-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
                <div class="form-text">At least 8 characters, with an uppercase letter, a lowercase letter and a number.</div>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-you w-100 py-2">Create my commander</button>
        </form>

        <p class="mt-3 mb-0 small">Already enlisted? <a asp-action="Login">Log in</a></p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}