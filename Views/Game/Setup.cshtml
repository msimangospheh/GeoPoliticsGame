@model List<(string Name, int Soldiers)>

@{
    ViewData["Title"] = "Select Your Country";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h3 class="mb-0">GEOPOLITICS: SELECT YOUR NATION</h3>
                </div>
                <div class="card-body bg-light">
                    <form asp-action="Create" method="post">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Choose the country you wish to command:</label>
                            <select name="chosenCountry" class="form-select form-select-lg">
                                @foreach (var country in Model)
                                {
                                    <option value="@country.Name">@country.Name — (@country.Soldiers Initial Soldiers)</option>
                                }
                            </select>
                            <div class="form-text mt-2">The remaining 9 countries will be randomly distributed among NPC opponents[cite: 1].</div>
                        </div>
                        <button type="submit" class="btn btn-danger btn-lg w-100 fw-bold shadow-sm">🚀 START CAMPAIGN</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
