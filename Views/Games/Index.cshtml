@model LobbyViewModel
@{
    ViewData["Title"] = "My campaigns";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <p class="eyebrow">The war room</p>
        <h1 class="mb-0">Welcome back, Commander @User.GetDisplayName()</h1>
    </div>
    <a class="btn btn-attack btn-lg px-4" asp-action="New">+ New campaign</a>
</div>

<partial name="_Messages" />

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Campaigns</div><div class="value">@Model.AllGames.Count</div></div></div>
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Victories</div><div class="value" style="color:var(--you-ink)">@Model.Victories</div></div></div>
    <div class="col-6 col-lg-3">
        <div class="panel stat-card">
            <div class="label">Win rate</div>
            <div class="value">@Model.WinRate%</div>
            <div class="segments mt-2"><span class="you" style="flex:@Model.WinRate"></span><span style="flex:@(100 - Model.WinRate)"></span></div>
        </div>
    </div>
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Avg rounds to win</div><div class="value">@Model.AvgRoundsToWin</div></div></div>
</div>

<div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3">
    <form method="get" class="search-box">
        <input type="hidden" name="status" value="@Model.Status" />
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search by game ID or nation" />
    </form>
    <nav class="pill-group">
        <a class="pill @(Model.Status == null ? "active" : "")" asp-action="Index" asp-route-search="@Model.Search">All</a>
        <a class="pill @(Model.Status == GameStatus.InProgress ? "active" : "")" asp-action="Index" asp-route-status="InProgress" asp-route-search="@Model.Search">In progress · @Model.CountOf(GameStatus.InProgress)</a>
        <a class="pill @(Model.Status == GameStatus.Won ? "active" : "")" asp-action="Index" asp-route-status="Won" asp-route-search="@Model.Search">Won · @Model.CountOf(GameStatus.Won)</a>
        <a class="pill @(Model.Status == GameStatus.Lost ? "active" : "")" asp-action="Index" asp-route-status="Lost" asp-route-search="@Model.Search">Lost · @Model.CountOf(GameStatus.Lost)</a>
    </nav>
</div>

@if (Model.AllGames.Count > 0 && Model.Shown.Count == 0)
{
    <p class="muted">No campaigns match that search.</p>
}

<div class="row g-3">
    @foreach (var game in Model.Shown)
    {
        <div class="col-md-6 col-lg-4"><partial name="_GameCard" model="game" /></div>
    }
    <div class="col-md-6 col-lg-4">
        <a class="new-campaign-card" asp-action="New">
            <div class="display fs-1 mb-2">+</div>
            <h3 class="h5">Begin a new campaign</h3>
            <p class="mb-0">Pick a homeland, face nine rivals</p>
        </a>
    </div>
</div>