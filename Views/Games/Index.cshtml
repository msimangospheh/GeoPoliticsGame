@model List<GeoPolitics_Game.Models.Game>
@using GeoPolitics_Game.Models
@{
    ViewData["Title"] = "My campaigns";
    var finished = Model.Where(g => g.IsOver).ToList();
    var wins = Model.Where(g => g.Status == GameStatus.Won).ToList();
    var winRate = finished.Count == 0 ? 0 : (int)Math.Round(100.0 * wins.Count / finished.Count);
    var avgRounds = wins.Count == 0 ? "-" : Math.Round(wins.Average(g => g.Round)).ToString();
}

<p class="eyebrow">The war room</p>
<h1 class="mb-4">Welcome back, Commander @User.GetDisplayName()</h1>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Campaigns</div><div class="value">@Model.Count</div></div></div>
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Victories</div><div class="value" style="color:var(--you-ink)">@wins.Count</div></div></div>
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Win rate</div><div class="value">@winRate%</div></div></div>
    <div class="col-6 col-lg-3"><div class="panel stat-card"><div class="label">Avg rounds to win</div><div class="value">@avgRounds</div></div></div>
</div>

@if (Model.Count == 0)
{
    <div class="new-campaign-card">
        <h3 class="h4">Begin a new campaign</h3>
        <p class="mb-0">Pick a homeland, face nine rivals. (The New Campaign screen arrives in Phase 5.)</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var g in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="panel h-100">
                    <div class="small fw-semibold muted">GAME #@g.ShortCode &middot; ROUND @g.Round</div>
                    <h3 class="h5 mt-2">@g.StartCountryCode</h3>
                    <span class="badge badge-npc">@g.Status</span>
                </div>
            </div>
        }
    </div>
}