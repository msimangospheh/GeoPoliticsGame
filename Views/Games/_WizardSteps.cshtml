@model int
@{
    var steps = new[] { "Homeland", "Rivals drawn", "Rules & launch" };
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <a asp-action="Index" class="muted text-decoration-none">&larr; Back to war room</a>
    <ol class="wizard-steps">
        @for (int i = 0; i < steps.Length; i++)
        {
            var n = i + 1;
            <li class="@(n < Model ? "done" : n == Model ? "current" : "")"><span>@n</span>@steps[i]</li>
        }
    </ol>
    <span></span>
</div>