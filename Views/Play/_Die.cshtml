@model (int Value, string Css, int Delay)
@{
    // Which of the 9 grid cells hold a pip for each face
    var pips = Model.Value switch
    {
        1 => new[] { 4 },
        2 => new[] { 0, 8 },
        3 => new[] { 0, 4, 8 },
        4 => new[] { 0, 2, 6, 8 },
        5 => new[] { 0, 2, 4, 6, 8 },
        _ => new[] { 0, 2, 3, 5, 6, 8 }
    };
}
<span class="die3d @Model.Css" style="--delay:@(Model.Delay)ms" role="img" aria-label="Die showing @Model.Value">
    @for (int i = 0; i < 9; i++)
    {
        <i class="@(pips.Contains(i) ? "pip" : "")"></i>
    }
</span>