<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Geopolitics</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="apple-touch-icon" href="~/images/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Black+Ops+One&family=Cormorant+Garamond:ital,wght@1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    @if ((string?)ViewData["BodyClass"] == "home")
    {
        <div class="map-layer" aria-hidden="true"></div>
    }
    <header class="site-header">
        <div class="container-xl d-flex align-items-center justify-content-between py-3 gap-3">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-icon" src="~/images/icon-64.png" alt="Geopolitics icon" />
                <span>
                    <span class="brand-name">GEOPOLITICS</span>
                    <span class="brand-tag">The Imperial Struggle</span>
                </span>
            </a>

            <nav class="main-nav d-none d-md-flex gap-4">
                <a href="/#how-to-play">How to play</a>
                <a asp-controller="Home" asp-action="Live">Watch live</a>
                <a asp-controller="Leaderboard" asp-action="Index">Leaderboard</a>
                <a asp-controller="Games" asp-action="Index">My campaigns</a>
            </nav>

            <div class="d-flex align-items-center gap-3">
                <div class="sound-controls">
                    <button type="button" class="sound-toggle" data-sound-btn="sfx" title="Sound effects on/off" aria-label="Sound effects">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M11 5 6 9H3v6h3l5 4z" />
                            <path class="when-on" d="M15.5 8.5a5 5 0 0 1 0 7M18.5 5.5a9 9 0 0 1 0 13" />
                            <path class="when-off" d="M16 9l6 6M22 9l-6 6" />
                        </svg>
                    </button>
                    <button type="button" class="sound-toggle" data-sound-btn="music" title="Music on/off" aria-label="Background music">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M9 18V5l12-2v13" />
                            <circle cx="6" cy="18" r="3" />
                            <circle cx="18" cy="16" r="3" />
                            <path class="when-off" d="M3 3l18 18" />
                        </svg>
                    </button>
                </div>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </header>

    <main class="container-xl py-4">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container-xl d-flex justify-content-between flex-wrap gap-2">
            <span>Geopolitics &middot; INF4001N project</span>
            <span>ASP.NET Core MVC &middot; MongoDB Atlas</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/sound.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/parallax.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>