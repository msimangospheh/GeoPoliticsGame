@if (User.Identity?.IsAuthenticated == true)
{
    var name = User.GetDisplayName();
    <div class="d-flex align-items-center gap-2">
        <span class="user-chip">
            <span class="avatar">@(string.IsNullOrEmpty(name) ? "?" : name[..1].ToUpper())</span>
            Commander @name
        </span>
        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
            <button type="submit" class="btn btn-ghost btn-sm">Log out</button>
        </form>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-ghost" asp-controller="Account" asp-action="Login">Log in</a>
        <a class="btn btn-you" asp-controller="Account" asp-action="Register">Sign up free</a>
    </div>
}